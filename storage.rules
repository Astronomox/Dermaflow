rules_version = '2';

// Firebase Storage Security Rules - DermaFlow
// Scan images are health data: strictly owner-only, capped size, images only.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User scan uploads: /users/{uid}/scans/{file}
    match /users/{userId}/scans/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
                   && request.resource.size < 10 * 1024 * 1024   // 10MB cap
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }

    // Everything else: denied by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
